<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fabric inspections list (screen 43) -->
    <record id="garment_fabric_inspection_view_list" model="ir.ui.view">
        <field name="name">garment.fabric.inspection.list</field>
        <field name="model">garment.fabric.inspection</field>
        <field name="arch" type="xml">
            <list string="Fabric Inspections" decoration-danger="result == 'reject'">
                <field name="name" string="Inspection"/>
                <field name="lot_id" string="Roll"/>
                <field name="product_id" string="Fabric"/>
                <field name="supplier_id"/>
                <field name="inspected_length_yd" string="Length (yd)" digits="[16, 1]"/>
                <field name="defect_count" string="Defects"/>
                <field name="penalty_points"/>
                <field name="points_per_100sqyd"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'pass'"
                       decoration-warning="result == 'hold'"
                       decoration-danger="result == 'reject'"/>
                <field name="state" optional="hide"/>
                <field name="date_inspected" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="garment_fabric_inspection_view_search" model="ir.ui.view">
        <field name="name">garment.fabric.inspection.search</field>
        <field name="model">garment.fabric.inspection</field>
        <field name="arch" type="xml">
            <search string="Fabric Inspections">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="garment_order_id"/>
                <filter name="last_30_days" string="Last 30 days"
                        domain="[('date_inspected', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="pass" string="Pass" domain="[('result', '=', 'pass')]"/>
                <filter name="hold" string="On hold" domain="[('result', '=', 'hold')]"/>
                <filter name="reject" string="Reject" domain="[('result', '=', 'reject')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_fabric" string="Fabric" context="{'group_by': 'product_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 4-point inspection (screen 44) -->
    <record id="garment_fabric_inspection_view_form" model="ir.ui.view">
        <field name="name">garment.fabric.inspection.form</field>
        <field name="model">garment.fabric.inspection</field>
        <field name="arch" type="xml">
            <form string="Fabric Inspection">
                <header>
                    <button name="action_print" type="object" string="Print"/>
                    <button name="action_open_tablet" type="object" string="Open on Tablet" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_done" type="object" string="Finish" invisible="state != 'in_progress'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <widget name="web_ribbon" title="On hold" bg_color="text-bg-warning" invisible="result != 'hold' or state != 'done'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="result != 'reject' or state != 'done'"/>
                    <widget name="web_ribbon" title="Passed" bg_color="text-bg-success" invisible="result != 'pass' or state != 'done'"/>
                    <div class="o_zyra_kpis o_zyra_kpis_6" name="kpi_strip">
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="not defect_count">
                            <span class="o_zyra_kpi_label">Defects</span>
                            <span class="o_zyra_kpi_value"><field name="defect_count"/></span>
                        </div>
                        <div class="o_zyra_kpi" invisible="defect_count">
                            <span class="o_zyra_kpi_label">Defects</span>
                            <span class="o_zyra_kpi_value"><field name="defect_count"/></span>
                        </div>
                        <div class="o_zyra_kpi">
                            <span class="o_zyra_kpi_label">Penalty points</span>
                            <span class="o_zyra_kpi_value"><field name="penalty_points"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_good" invisible="result_auto != 'pass'">
                            <span class="o_zyra_kpi_label">Points / 100 sq yd</span>
                            <span class="o_zyra_kpi_value"><field name="points_per_100sqyd"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_bad" invisible="result_auto == 'pass'">
                            <span class="o_zyra_kpi_label">Points / 100 sq yd</span>
                            <span class="o_zyra_kpi_value"><field name="points_per_100sqyd"/></span>
                        </div>
                        <div class="o_zyra_kpi">
                            <span class="o_zyra_kpi_label">Accept limit</span>
                            <span class="o_zyra_kpi_value"><field name="accept_limit" readonly="1"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_text o_zyra_kpi_good" invisible="result != 'pass'">
                            <span class="o_zyra_kpi_label">Result</span>
                            <span class="o_zyra_kpi_value"><field name="result"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_text o_zyra_kpi_warn" invisible="result != 'hold'">
                            <span class="o_zyra_kpi_label">Result</span>
                            <span class="o_zyra_kpi_value"><field name="result"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_text o_zyra_kpi_bad" invisible="result != 'reject'">
                            <span class="o_zyra_kpi_label">Result</span>
                            <span class="o_zyra_kpi_value"><field name="result"/></span>
                        </div>
                    </div>
                    <div class="oe_title">
                        <div class="text-muted"><field name="name" readonly="1"/></div>
                        <h1><field name="lot_id" placeholder="Roll" options="{'no_create': True}"
                                   readonly="state != 'in_progress'"/></h1>
                    </div>
                    <group>
                        <group string="Roll" name="roll">
                            <field name="product_id" string="Fabric"/>
                            <field name="supplier_id"/>
                            <field name="dye_lot"/>
                            <field name="garment_order_id"/>
                            <label for="roll_length"/>
                            <div class="o_row">
                                <field name="roll_length"/>
                                <field name="roll_uom_id" options="{'no_open': True}"/>
                            </div>
                        </group>
                        <group string="Inspection" name="inspection">
                            <field name="inspector_id"/>
                            <field name="date_inspected"/>
                            <field name="frame" optional="hide"/>
                        </group>
                        <group string="Measures" name="measures">
                            <field name="inspected_length_yd" readonly="state != 'in_progress'"/>
                            <field name="cuttable_width_in" readonly="state != 'in_progress'"/>
                            <field name="width_measured_in" readonly="state != 'in_progress'"/>
                            <field name="gsm_measured" readonly="state != 'in_progress'"/>
                        </group>
                        <group string="Result" name="result">
                            <field name="penalty_points"/>
                            <field name="points_per_100sqyd"/>
                            <field name="accept_limit" readonly="state != 'in_progress'"/>
                            <field name="result_auto" invisible="1"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'pass'"
                                   decoration-warning="result == 'hold'"
                                   decoration-danger="result == 'reject'"/>
                            <field name="result_override" readonly="state != 'in_progress'"
                                   invisible="state != 'in_progress'"/>
                            <field name="reason" readonly="state != 'in_progress'"
                                   required="result_override"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Defects" name="defects">
                            <field name="defect_line_ids" nolabel="1" readonly="state != 'in_progress'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="position_yd"/>
                                    <field name="defect_id" options="{'no_create': True}"/>
                                    <field name="length_band"/>
                                    <field name="points" sum="Total"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_garment_fabric_inspection" model="ir.actions.act_window">
        <field name="name">Fabric Inspections</field>
        <field name="res_model">garment.fabric.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="garment_fabric_inspection_view_search"/>
        <field name="context">{'search_default_last_30_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inspect a roll with the 4-point system</p>
            <p>Use the inspection tablet on the frame, or enter the defects here.</p>
        </field>
    </record>

    <record id="action_fabric_inspection_tablet" model="ir.actions.client">
        <field name="name">Inspection Tablet</field>
        <field name="tag">zyra_fabric_inspection_tablet</field>
    </record>
</odoo>
