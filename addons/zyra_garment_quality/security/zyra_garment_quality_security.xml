            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_garment_capa_company" model="ir.rule">
            <field name="name">CAPAs: own companies</field>
            <field name="model_id" ref="model_garment_capa"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
