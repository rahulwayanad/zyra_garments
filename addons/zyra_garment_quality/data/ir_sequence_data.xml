<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_garment_inspection" model="ir.sequence">
            <field name="name">Quality Inspection</field>
            <field name="code">garment.inspection</field>
            <field name="prefix">QI/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_garment_capa" model="ir.sequence">
            <field name="name">Corrective Action</field>
            <field name="code">garment.capa</field>
            <field name="prefix">CAPA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
