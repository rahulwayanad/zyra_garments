<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_garment_quality" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.garment.quality</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="zyra_garment_base.res_config_settings_view_form_garment"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='garment_fabric_quality']" position="after">
                <setting id="garment_garment_quality" string="Garment inspection"
                         help="AQL for final inspections, end-line DHU limit and when a CAPA is raised by itself.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="garment_aql_major" class="col-lg-5 o_light_label"/>
                            <field name="garment_aql_major"/>
                        </div>
                        <div class="row">
                            <label for="garment_aql_minor" class="col-lg-5 o_light_label"/>
                            <field name="garment_aql_minor"/>
                        </div>
                        <div class="row">
                            <label for="garment_dhu_limit" class="col-lg-5 o_light_label"/>
                            <field name="garment_dhu_limit"/>
                        </div>
                        <div class="row">
                            <label for="garment_capa_threshold" class="col-lg-5 o_light_label"/>
                            <field name="garment_capa_threshold"/>
                        </div>
                        <div class="row">
                            <label for="garment_capa_window_days" class="col-lg-5 o_light_label"/>
                            <field name="garment_capa_window_days"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
