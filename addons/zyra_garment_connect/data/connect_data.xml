<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_garment_api_key" model="ir.sequence">
            <field name="name">Garment API Key</field>
            <field name="code">garment.api.key</field>
            <field name="prefix">KEY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_garment_webhook" model="ir.sequence">
            <field name="name">Garment Webhook</field>
            <field name="code">garment.webhook</field>
            <field name="prefix">WH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_garment_import" model="ir.sequence">
            <field name="name">Garment CSV Import</field>
            <field name="code">garment.import</field>
            <field name="prefix">IMP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_garment_webhook_deliver" model="ir.cron">
            <field name="name">Garment: deliver webhooks</field>
            <field name="model_id" ref="model_garment_webhook"/>
            <field name="state">code</field>
            <field name="code">model._cron_deliver()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
