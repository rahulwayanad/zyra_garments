<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_garment_rate_card_company" model="ir.rule">
        <field name="name">Rate card: own companies</field>
        <field name="model_id" ref="model_garment_rate_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_garment_wage_sheet_company" model="ir.rule">
        <field name="name">Wage sheet: own companies</field>
        <field name="model_id" ref="model_garment_wage_sheet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_garment_wage_sheet_line_company" model="ir.rule">
        <field name="name">Wage sheet line: own companies</field>
        <field name="model_id" ref="model_garment_wage_sheet_line"/>
        <field name="domain_force">[('sheet_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
