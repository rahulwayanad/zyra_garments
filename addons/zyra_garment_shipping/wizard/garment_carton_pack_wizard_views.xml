<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_carton_pack_wizard_view_form" model="ir.ui.view">
        <field name="name">garment.carton.pack.wizard.form</field>
        <field name="model">garment.carton.pack.wizard</field>
        <field name="arch" type="xml">
            <form string="Pack / Scan Cartons">
                <field name="plan_id" invisible="1"/>
                <div class="alert alert-success" role="status" invisible="not last_result">
                    <field name="last_result"/>
                </div>
                <group>
                    <field name="scan" placeholder="Scan the SSCC label or type the carton number"
                           default_focus="1"/>
                    <field name="count"/>
                    <label for="cartons_packed" string="Cartons packed"/>
                    <div><field name="cartons_packed" class="oe_inline"/> / <field name="cartons_planned" class="oe_inline"/></div>
                </group>
                <footer>
                    <button name="action_pack" type="object" string="Pack" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
