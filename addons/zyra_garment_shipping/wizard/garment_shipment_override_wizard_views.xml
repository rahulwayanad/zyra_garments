<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manager override wizard -->
    <record id="garment_shipment_override_wizard_view_form" model="ir.ui.view">
        <field name="name">garment.shipment.override.wizard.form</field>
        <field name="model">garment.shipment.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Manager Override">
                <field name="shipment_id" invisible="1"/>
                <div class="alert alert-warning" role="alert" style="white-space: pre-line;">
                    <field name="warnings" readonly="1"/>
                </div>
                <group>
                    <field name="reason" placeholder="Why the shipment may leave anyway, and who agreed."/>
                </group>
                <footer>
                    <button name="action_override" type="object" string="Override" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
