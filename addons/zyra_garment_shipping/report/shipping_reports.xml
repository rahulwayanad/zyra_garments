<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_packing_list" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">garment.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zyra_garment_shipping.report_packing_list</field>
        <field name="report_file">zyra_garment_shipping.report_packing_list</field>
        <field name="print_report_name">'Packing list - %s' % object.name.replace('/', '-')</field>
        <field name="binding_model_id" ref="model_garment_shipment"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_pack_plan_packing_list" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">garment.pack.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zyra_garment_shipping.report_pack_plan_packing_list</field>
        <field name="report_file">zyra_garment_shipping.report_pack_plan_packing_list</field>
        <field name="print_report_name">'Packing list - %s' % object.name.replace('/', '-')</field>
        <field name="binding_model_id" ref="model_garment_pack_plan"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
