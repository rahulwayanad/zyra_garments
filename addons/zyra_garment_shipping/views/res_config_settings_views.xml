<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_garment_shipping" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.garment.shipping</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="zyra_garment_base.res_config_settings_view_form_garment"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='garment_factory_figures']" position="after">
                <block title="Packing and shipping" name="garment_shipping">
                    <setting id="garment_sscc" string="Carton labels (SSCC-18)"
                             help="GS1 company prefix and extension digit used to number cartons.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="garment_gs1_prefix" class="col-lg-5 o_light_label"/>
                                <field name="garment_gs1_prefix"/>
                            </div>
                            <div class="row">
                                <label for="garment_sscc_extension" class="col-lg-5 o_light_label"/>
                                <field name="garment_sscc_extension"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
