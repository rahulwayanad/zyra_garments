<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_approval_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="border: 2px solid #1d1b2c; padding: 16px; max-width: 560px;">
                        <h4 class="mb-1"><t t-esc="o.name"/> · <span t-field="o.kind"/></h4>
                        <div class="fw-bold mb-2"><t t-esc="o.style_id.display_name"/></div>
                        <div><strong>Buyer:</strong> <t t-esc="o.buyer_id.name or ''"/></div>
                        <div><strong>Colourway:</strong> <t t-esc="o.colour_id.name or ''"/></div>
                        <div t-if="o.material_id"><strong>Material:</strong> <t t-esc="o.material_id.display_name"/></div>
                        <div><strong>Submission:</strong> <t t-esc="o.submission"/></div>
                        <div><strong>Decision due:</strong> <span t-field="o.decision_due"/></div>
                        <table class="table table-sm mt-3" t-if="o.option_ids">
                            <thead><tr><th>Option</th><th>Swatch</th><th>Note</th><th>Buyer's choice</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.option_ids" t-as="opt">
                                    <td><t t-esc="opt.name"/></td>
                                    <td><div t-attf-style="width: 60px; height: 40px; border: 1px solid #ccc; background: {{ opt.hex or '#ffffff' }};"/></td>
                                    <td><t t-esc="opt.note or ''"/></td>
                                    <td><t t-if="opt == o.chosen_option_id">✔</t><t t-else="">☐</t></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="mt-3"><strong>Buyer comments:</strong></div>
                        <div style="min-height: 60px; white-space: pre-wrap;" t-esc="o.buyer_comment or ''"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
