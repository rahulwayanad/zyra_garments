<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_garment_merch" model="ir.ui.view">
        <field name="name">sale.order.form.garment.merch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_garment_orders" type="object" class="oe_stat_button" icon="fa-industry"
                        invisible="not garment_order_count">
                    <field name="garment_order_count" string="Production Orders" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
