<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Open production orders (screen 33) -->
    <record id="garment_order_view_list" model="ir.ui.view">
        <field name="name">garment.order.list</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <list string="Production Orders" decoration-danger="is_late" sample="1">
                <field name="is_late" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="name" string="Order No."/>
                <field name="style_id"/>
                <field name="buyer_id"/>
                <field name="buyer_po" string="Buyer PO"/>
                <field name="ex_factory_date" string="Ex-factory" widget="date"/>
                <field name="qty_ordered" sum="Total"/>
                <field name="qty_cut" sum="Total"/>
                <field name="qty_sewn" sum="Total"/>
                <field name="qty_packed" sum="Total"/>
                <field name="qty_shipped" sum="Total"/>
                <field name="packed_pct" widget="progressbar"/>
                <field name="sewing_line_id"/>
                <field name="order_value" sum="Total"/>
                <field name="state" optional="hide" widget="badge"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="garment_order_view_search" model="ir.ui.view">
        <field name="name">garment.order.search</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <search string="Production Orders">
                <field name="name"/>
                <field name="style_id"/>
                <field name="buyer_id"/>
                <field name="buyer_po"/>
                <field name="sale_order_id"/>
                <field name="sewing_line_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'confirmed', 'in_production', 'packed'))]"/>
                <filter name="late" string="Late" domain="[('is_late', '=', True)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_production" string="In Production" domain="[('state', '=', 'in_production')]"/>
                <filter name="shipped" string="Shipped" domain="[('state', 'in', ('shipped', 'closed'))]"/>
                <separator/>
                <filter name="my_orders" string="My Orders" domain="[('merchandiser_id', '=', uid)]"/>
                <filter name="ex_factory" string="Ex-factory" date="ex_factory_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_style" string="Style" context="{'group_by': 'style_id'}"/>
                    <filter name="group_line" string="Sewing Line" context="{'group_by': 'sewing_line_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_ex_factory" string="Ex-factory Month" context="{'group_by': 'ex_factory_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Production order (screens 2, 34, 35, 36) -->
    <record id="garment_order_view_form" model="ir.ui.view">
        <field name="name">garment.order.form</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <form string="Production Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Order" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_production" type="object" string="Start Production"
                            invisible="state != 'confirmed'"/>
                    <button name="action_mark_completed" type="object" string="Mark Completed"
                            invisible="state not in ('in_production', 'packed', 'shipped')"/>
                    <button name="action_close" type="object" string="Close Order"
                            groups="zyra_garment_base.group_garment_factory_manager"
                            invisible="state not in ('confirmed', 'in_production', 'packed', 'shipped')"
                            confirm="Close this order? Pieces not shipped stay unshipped."/>
                    <button name="action_amend" type="object" string="Amend Order"
                            invisible="state not in ('confirmed', 'in_production', 'packed') or is_amending"/>
                    <button name="action_done_amending" type="object" string="Done Amending" class="btn-primary"
                            invisible="not is_amending"/>
                    <button name="action_apply_tna_template" type="object" string="Apply T&amp;A Template"
                            invisible="not tna_template_id or milestone_count or state in ('closed', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="confirmed,in_production,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-dollar"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sale Order</span>
                                <span class="o_stat_value"><field name="sale_order_name"/></span>
                            </div>
                        </button>
                        <button name="action_view_postings" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="posting_count" widget="statinfo" string="Postings"/>
                        </button>
                        <button name="action_view_samples" type="object" class="oe_stat_button" icon="fa-tags">
                            <field name="sample_count" widget="statinfo" string="Samples"/>
                        </button>
                        <button name="action_view_cost_sheet" type="object" class="oe_stat_button" icon="fa-calculator"
                                invisible="not has_cost_sheet">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Cost Sheets</span>
                                <span class="o_stat_value">1</span>
                            </div>
                        </button>
                        <button name="action_view_milestones" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="milestone_count" widget="statinfo" string="Milestones"/>
                        </button>
                    </div>
                    <field name="is_late" invisible="1"/>
                    <field name="is_amending" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="size_range_id" invisible="1"/>
                    <field name="pp_sample_ok" invisible="1"/>
                    <field name="milestone_overdue_count" invisible="1"/>
                    <field name="milestone_done_count" invisible="1"/>
                    <field name="has_cost_sheet" invisible="1"/>
                    <field name="planned_margin_low" invisible="1"/>

                    <!-- KPI strip (screen 2). Wave-3 modules add their tiles after the named ones. -->
                    <div class="o_zyra_kpis" name="kpi_strip" invisible="state == 'draft'">
                        <div name="kpi_ex_factory" class="o_zyra_kpi o_zyra_kpi_bad" invisible="days_to_ex_factory &gt;= 0 or state in ('shipped', 'closed')">
                            <span class="o_zyra_kpi_label">Ex-factory in</span>
                            <span class="o_zyra_kpi_value"><field name="days_to_ex_factory"/> d</span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="days_to_ex_factory &lt; 0 or days_to_ex_factory &gt; 7 or state in ('shipped', 'closed')">
                            <span class="o_zyra_kpi_label">Ex-factory in</span>
                            <span class="o_zyra_kpi_value"><field name="days_to_ex_factory"/> d</span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_good" invisible="days_to_ex_factory &lt;= 7 and state not in ('shipped', 'closed')">
                            <span class="o_zyra_kpi_label">Ex-factory in</span>
                            <span class="o_zyra_kpi_value"><field name="days_to_ex_factory"/> d</span>
                        </div>
                        <div name="kpi_cut" class="o_zyra_kpi o_zyra_kpi_good" invisible="qty_cut &lt; qty_ordered">
                            <span class="o_zyra_kpi_label">Cut</span>
                            <span class="o_zyra_kpi_value"><field name="qty_cut"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="qty_cut &gt;= qty_ordered">
                            <span class="o_zyra_kpi_label">Cut</span>
                            <span class="o_zyra_kpi_value"><field name="qty_cut"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div name="kpi_sewn" class="o_zyra_kpi o_zyra_kpi_good" invisible="qty_sewn &lt; qty_ordered">
                            <span class="o_zyra_kpi_label">Sewn</span>
                            <span class="o_zyra_kpi_value"><field name="qty_sewn"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="qty_sewn &gt;= qty_ordered">
                            <span class="o_zyra_kpi_label">Sewn</span>
                            <span class="o_zyra_kpi_value"><field name="qty_sewn"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div name="kpi_packed" class="o_zyra_kpi o_zyra_kpi_good" invisible="qty_packed &lt; qty_ordered">
                            <span class="o_zyra_kpi_label">Packed</span>
                            <span class="o_zyra_kpi_value"><field name="qty_packed"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="qty_packed &gt;= qty_ordered">
                            <span class="o_zyra_kpi_label">Packed</span>
                            <span class="o_zyra_kpi_value"><field name="qty_packed"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div name="kpi_shipped" class="o_zyra_kpi o_zyra_kpi_good" invisible="qty_shipped &lt; qty_ordered">
                            <span class="o_zyra_kpi_label">Shipped</span>
                            <span class="o_zyra_kpi_value"><field name="qty_shipped"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="qty_shipped &gt;= qty_ordered">
                            <span class="o_zyra_kpi_label">Shipped</span>
                            <span class="o_zyra_kpi_value"><field name="qty_shipped"/> / <field name="qty_ordered"/></span>
                        </div>
                        <div name="kpi_order_value" class="o_zyra_kpi">
                            <span class="o_zyra_kpi_label">Order value</span>
                            <span class="o_zyra_kpi_value"><field name="order_value" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                        </div>
                        <div name="kpi_pp_sample" class="o_zyra_kpi o_zyra_kpi_text o_zyra_kpi_good" invisible="not pp_sample_ok">
                            <span class="o_zyra_kpi_label">PP sample</span>
                            <span class="o_zyra_kpi_value"><field name="pp_sample_status"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_text o_zyra_kpi_warn" invisible="pp_sample_ok">
                            <span class="o_zyra_kpi_label">PP sample</span>
                            <span class="o_zyra_kpi_value"><field name="pp_sample_status"/></span>
                        </div>
                        <div name="kpi_tna" class="o_zyra_kpi o_zyra_kpi_good" invisible="milestone_overdue_count">
                            <span class="o_zyra_kpi_label">Time &amp; action</span>
                            <span class="o_zyra_kpi_value"><field name="milestone_done_count"/> / <field name="milestone_count"/></span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_warn" invisible="not milestone_overdue_count">
                            <span class="o_zyra_kpi_label">Time &amp; action</span>
                            <span class="o_zyra_kpi_value"><field name="milestone_done_count"/> / <field name="milestone_count"/></span>
                        </div>
                        <div name="kpi_margin" class="o_zyra_kpi o_zyra_kpi_bad" invisible="not has_cost_sheet or not planned_margin_low">
                            <span class="o_zyra_kpi_label">Planned margin</span>
                            <span class="o_zyra_kpi_value"><field name="planned_margin_pct" digits="[16, 1]"/>%</span>
                        </div>
                        <div class="o_zyra_kpi o_zyra_kpi_good" invisible="not has_cost_sheet or planned_margin_low">
                            <span class="o_zyra_kpi_label">Planned margin</span>
                            <span class="o_zyra_kpi_value"><field name="planned_margin_pct" digits="[16, 1]"/>%</span>
                        </div>
                    </div>

                    <field name="image_128" widget="image" class="oe_avatar" readonly="1"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="name" readonly="1"/></div>
                        <h1>
                            <field name="style_id" placeholder="Style" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group name="header_groups">
                        <group string="Buyer" name="buyer">
                            <field name="buyer_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="buyer_po" string="Buyer PO No."/>
                            <field name="business_model"/>
                            <field name="merchandiser_id"/>
                            <field name="price_unit" readonly="state not in ('draft', 'confirmed') and not is_amending"/>
                        </group>
                        <group string="Delivery" name="delivery">
                            <field name="date_order"/>
                            <field name="ex_factory_date"/>
                            <field name="days_to_ex_factory" invisible="state == 'draft'"/>
                            <field name="sewing_line_id"/>
                            <field name="tna_template_id"/>
                        </group>
                    </group>
                    <group name="grid_setup" string="Grid set-up" invisible="state != 'draft' and not is_amending">
                        <group>
                            <field name="techpack_id" options="{'no_create': True}"/>
                            <field name="sale_order_id" readonly="1" invisible="not sale_order_id"/>
                        </group>
                        <group>
                            <field name="colour_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="size_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group name="planned_cost" invisible="not has_cost_sheet">
                        <group string="Planned cost per piece">
                            <field name="planned_material_pc" string="Planned material / pc"/>
                            <field name="planned_making_pc" string="Planned making cost / pc"/>
                            <field name="planned_other_pc" string="Planned other cost / pc"/>
                            <field name="planned_margin_pct" string="Planned margin %"/>
                            <field name="cost_sheet_ref" string="Approved cost sheet"/>
                        </group>
                    </group>
                    <notebook name="order_tabs">
                        <page string="Size &amp; Colour" name="size_colour">
                            <field name="line_ids" widget="zyra_size_colour_grid" nolabel="1"
                                   readonly="state != 'draft' and not is_amending">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="colour_id"/>
                                    <field name="colour_hex" column_invisible="1"/>
                                    <field name="size_id"/>
                                    <field name="size_sequence" column_invisible="1"/>
                                    <field name="qty_ordered"/>
                                    <field name="qty_cut"/>
                                    <field name="qty_sewn"/>
                                    <field name="qty_packed"/>
                                    <field name="qty_shipped"/>
                                    <field name="qty_balance"/>
                                </list>
                            </field>
                        </page>
                        <page string="Breakdown Lines" name="breakdown">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft' and not is_amending">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="colour_id" readonly="1"/>
                                    <field name="colour_hex" column_invisible="1"/>
                                    <field name="size_id" readonly="1"/>
                                    <field name="size_sequence" column_invisible="1"/>
                                    <field name="qty_ordered"/>
                                    <field name="qty_cut"/>
                                    <field name="qty_sewn"/>
                                    <field name="qty_packed"/>
                                    <field name="qty_shipped"/>
                                    <field name="qty_balance"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sampling" name="sampling">
                            <field name="sample_ids" nolabel="1" context="{'default_order_id': id, 'default_style_id': style_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="sample_type"/>
                                    <field name="colour_id"/>
                                    <field name="round"/>
                                    <field name="required_date"/>
                                    <field name="sent_date"/>
                                    <field name="decision_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-info="state == 'with_buyer'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Time &amp; Action" name="tna">
                            <field name="milestone_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="planned_date"/>
                                    <field name="actual_date"/>
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <field name="status" column_invisible="1"/>
                                    <field name="status_label" string="Status" widget="badge"
                                           decoration-success="status == 'on_time'"
                                           decoration-warning="status == 'late'"
                                           decoration-danger="status == 'overdue'"
                                           decoration-muted="status == 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="garment_order_view_pivot" model="ir.ui.view">
        <field name="name">garment.order.pivot</field>
        <field name="model">garment.order</field>
        <field name="arch" type="xml">
            <pivot string="Production Orders">
                <field name="buyer_id" type="row"/>
                <field name="state" type="col"/>
                <field name="qty_ordered" type="measure"/>
                <field name="qty_shipped" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_garment_order" model="ir.actions.act_window">
        <field name="name">Production Orders</field>
        <field name="res_model">garment.order</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="garment_order_view_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a production order</p>
            <p>Confirming a sale order for a garment style opens its production order with the size and
               colour grid. You can also create one here.</p>
        </field>
    </record>

    <!-- Progress postings -->
    <record id="garment_order_progress_view_list" model="ir.ui.view">
        <field name="name">garment.order.progress.list</field>
        <field name="model">garment.order.progress</field>
        <field name="arch" type="xml">
            <list string="Postings" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="order_id"/>
                <field name="stage" widget="badge"/>
                <field name="colour_id"/>
                <field name="size_id"/>
                <field name="qty" sum="Total"/>
                <field name="ref"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="garment_order_progress_view_search" model="ir.ui.view">
        <field name="name">garment.order.progress.search</field>
        <field name="model">garment.order.progress</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="ref"/>
                <filter name="cut" string="Cut" domain="[('stage', '=', 'cut')]"/>
                <filter name="sewn" string="Sewn" domain="[('stage', '=', 'sewn')]"/>
                <filter name="packed" string="Packed" domain="[('stage', '=', 'packed')]"/>
                <filter name="shipped" string="Shipped" domain="[('stage', '=', 'shipped')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_colour" string="Colourway" context="{'group_by': 'colour_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_order_progress" model="ir.actions.act_window">
        <field name="name">Production Postings</field>
        <field name="res_model">garment.order.progress</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
