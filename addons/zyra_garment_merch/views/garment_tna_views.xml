<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_tna_template_view_list" model="ir.ui.view">
        <field name="name">garment.tna.template.list</field>
        <field name="model">garment.tna.template</field>
        <field name="arch" type="xml">
            <list string="T&amp;A Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="lead_days"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="garment_tna_template_view_form" model="ir.ui.view">
        <field name="name">garment.tna.template.form</field>
        <field name="model">garment.tna.template</field>
        <field name="arch" type="xml">
            <form string="T&amp;A Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Bulk order – 8 weeks"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_days"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="days_before_ex_factory"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_tna_template" model="ir.actions.act_window">
        <field name="name">T&amp;A Templates</field>
        <field name="res_model">garment.tna.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="garment_tna_milestone_view_list" model="ir.ui.view">
        <field name="name">garment.tna.milestone.list</field>
        <field name="model">garment.tna.milestone</field>
        <field name="arch" type="xml">
            <list string="Time and Action" editable="bottom" create="0"
                  decoration-danger="status == 'overdue'">
                <field name="order_id" readonly="1"/>
                <field name="name"/>
                <field name="planned_date"/>
                <field name="actual_date"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="status" column_invisible="1"/>
                <field name="status_label" string="Status" widget="badge"
                       decoration-success="status == 'on_time'" decoration-warning="status == 'late'"
                       decoration-danger="status == 'overdue'" decoration-muted="status == 'pending'"/>
                <button name="action_mark_done" type="object" string="Done" icon="fa-check"
                        invisible="actual_date"/>
            </list>
        </field>
    </record>

    <record id="garment_tna_milestone_view_search" model="ir.ui.view">
        <field name="name">garment.tna.milestone.search</field>
        <field name="model">garment.tna.milestone</field>
        <field name="arch" type="xml">
            <search string="Time and Action">
                <field name="name"/>
                <field name="order_id"/>
                <field name="owner_id"/>
                <filter name="mine" string="My Milestones" domain="[('owner_id', '=', uid)]"/>
                <filter name="open" string="Not Done" domain="[('actual_date', '=', False)]"/>
                <filter name="overdue" string="Overdue" domain="[('status', '=', 'overdue')]"/>
                <filter name="this_week" string="Due This Week"
                        domain="[('actual_date', '=', False), ('planned_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_order" string="Production Order" context="{'group_by': 'order_id'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_planned" string="Planned Week" context="{'group_by': 'planned_date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="garment_tna_milestone_view_calendar" model="ir.ui.view">
        <field name="name">garment.tna.milestone.calendar</field>
        <field name="model">garment.tna.milestone</field>
        <field name="arch" type="xml">
            <calendar string="Time and Action" date_start="planned_date" mode="month" color="owner_id"
                      quick_create="0" create="0" event_open_popup="1">
                <field name="order_id"/>
                <field name="owner_id"/>
                <field name="status_label"/>
            </calendar>
        </field>
    </record>

    <record id="action_garment_tna_milestone" model="ir.actions.act_window">
        <field name="name">Time and Action</field>
        <field name="res_model">garment.tna.milestone</field>
        <field name="view_mode">list,calendar</field>
        <field name="search_view_id" ref="garment_tna_milestone_view_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_group_order': 1}</field>
    </record>
</odoo>
