<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_garment_order" model="ir.sequence">
            <field name="name">Production Order</field>
            <field name="code">garment.order</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_garment_sample" model="ir.sequence">
            <field name="name">Garment Sample</field>
            <field name="code">garment.sample</field>
            <field name="prefix">SMP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_garment_approval" model="ir.sequence">
            <field name="name">Approval Card</field>
            <field name="code">garment.approval</field>
            <field name="prefix">APR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
