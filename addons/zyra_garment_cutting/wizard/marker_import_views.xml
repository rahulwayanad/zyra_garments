<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_marker_import_view_form" model="ir.ui.view">
        <field name="name">garment.marker.import.form</field>
        <field name="model">garment.marker.import</field>
        <field name="arch" type="xml">
            <form string="Import Markers">
                <p class="text-muted">
                    CSV columns: <code>name, ratio, length_m, width_cm, efficiency_pct</code>.
                    Ratio as size:ratio pairs, e.g. <code>15:1 17:1</code>. A marker with the same name is updated.
                </p>
                <group>
                    <field name="style_id" options="{'no_create': True}"/>
                    <field name="colour_id" options="{'no_create': True}"/>
                    <field name="fabric_id" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="builder_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_garment_marker_import" model="ir.actions.act_window">
        <field name="name">Import Markers (CSV)</field>
        <field name="res_model">garment.marker.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
