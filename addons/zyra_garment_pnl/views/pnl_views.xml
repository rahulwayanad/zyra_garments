<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 74: Order P&L list -->
    <record id="view_garment_order_pnl_list" model="ir.ui.view">
        <field name="name">garment.order.pnl.list</field>
        <field name="model">garment.order.pnl</field>
        <field name="arch" type="xml">
            <list string="Order P&amp;L" decoration-danger="is_loss">
                <field name="is_loss" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="name" string="Order"/>
                <field name="buyer_id"/>
                <field name="revenue" string="Revenue" sum="Total"/>
                <field name="planned_cost" sum="Total"/>
                <field name="actual_cost" sum="Total"/>
                <field name="cost_variance" sum="Total"/>
                <field name="margin_ratio" string="Margin %" widget="percentage" digits="[16, 1]"/>
                <field name="cost_pc" string="Cost / PC"/>
            </list>
        </field>
    </record>

    <!-- Screen 75: P&L of one order -->
    <record id="view_garment_order_pnl_form" model="ir.ui.view">
        <field name="name">garment.order.pnl.form</field>
        <field name="model">garment.order.pnl</field>
        <field name="arch" type="xml">
            <form string="Order P&amp;L">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_loss" invisible="1"/>
                    <div class="o_zyra_kpis">
                        <div class="o_zyra_kpi"><span class="o_zyra_kpi_label">Revenue</span><span class="o_zyra_kpi_value"><field name="revenue"/></span></div>
                        <div class="o_zyra_kpi"><span class="o_zyra_kpi_label">Actual Cost</span><span class="o_zyra_kpi_value"><field name="actual_cost"/></span></div>
                        <div class="o_zyra_kpi o_zyra_kpi_good" invisible="is_loss"><span class="o_zyra_kpi_label">Margin</span><span class="o_zyra_kpi_value"><field name="margin"/></span></div>
                        <div class="o_zyra_kpi o_zyra_kpi_bad" invisible="not is_loss"><span class="o_zyra_kpi_label">Margin</span><span class="o_zyra_kpi_value"><field name="margin"/></span></div>
                        <div class="o_zyra_kpi o_zyra_kpi_good" invisible="is_loss"><span class="o_zyra_kpi_label">Margin %</span><span class="o_zyra_kpi_value"><field name="margin_pct" digits="[16, 1]"/>%</span></div>
                        <div class="o_zyra_kpi o_zyra_kpi_bad" invisible="not is_loss"><span class="o_zyra_kpi_label">Margin %</span><span class="o_zyra_kpi_value"><field name="margin_pct" digits="[16, 1]"/>%</span></div>
                        <div class="o_zyra_kpi"><span class="o_zyra_kpi_label">Planned Margin %</span><span class="o_zyra_kpi_value"><field name="planned_margin_pct" digits="[16, 1]"/>%</span></div>
                        <div class="o_zyra_kpi o_zyra_kpi_bad" invisible="cost_variance &lt;= 0"><span class="o_zyra_kpi_label">Cost Variance</span><span class="o_zyra_kpi_value"><field name="cost_variance"/></span></div>
                        <div class="o_zyra_kpi o_zyra_kpi_good" invisible="cost_variance &gt; 0"><span class="o_zyra_kpi_label">Cost Variance</span><span class="o_zyra_kpi_value"><field name="cost_variance"/></span></div>
                        <div class="o_zyra_kpi"><span class="o_zyra_kpi_label">Cost / pc</span><span class="o_zyra_kpi_value"><field name="cost_pc"/></span></div>
                    </div>
                    <div class="oe_title">
                        <div class="text-muted">Order profitability</div>
                        <h1><field name="name" invisible="not id"/><field name="order_id" invisible="id" placeholder="Production order" options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group string="Order">
                            <field name="buyer_id"/>
                            <field name="style_id"/>
                            <field name="business_model"/>
                            <field name="order_status"/>
                            <field name="date_ex_factory"/>
                        </group>
                        <group string="Pieces">
                            <field name="qty_ordered"/>
                            <field name="pieces_costed"/>
                            <field name="qty_shipped"/>
                            <field name="revenue_pc"/>
                            <field name="cost_pc"/>
                            <field name="margin_pc"/>
                        </group>
                        <group string="Revenue">
                            <field name="order_value"/>
                            <field name="revenue"/>
                            <field name="margin"/>
                            <field name="margin_pct"/>
                        </group>
                        <group string="Planned Cost">
                            <field name="planned_material"/>
                            <field name="planned_making"/>
                            <field name="planned_other"/>
                            <field name="planned_cost"/>
                            <field name="planned_margin_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Actual Cost" name="actual">
                            <group>
                                <group>
                                    <field name="actual_material"/>
                                    <field name="actual_making"/>
                                    <field name="actual_jobwork"/>
                                    <field name="actual_other"/>
                                    <field name="actual_cost"/>
                                    <field name="cost_variance"/>
                                </group>
                                <group>
                                    <field name="cost_sheet_ref"/>
                                    <field name="last_refresh"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other Costs" name="other">
                            <field name="cost_line_ids">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_garment_order_pnl_search" model="ir.ui.view">
        <field name="name">garment.order.pnl.search</field>
        <field name="model">garment.order.pnl</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Order"/>
                <field name="buyer_id"/>
                <field name="style_id"/>
                <filter name="closed" string="Closed orders" domain="[('is_closed', '=', True)]"/>
                <filter name="open" string="Open orders" domain="[('is_closed', '=', False)]"/>
                <filter name="loss" string="Loss-making" domain="[('is_loss', '=', True)]"/>
                <filter name="over_plan" string="Over plan" domain="[('cost_variance', '&gt;', 0)]"/>
                <separator/>
                <filter name="ex_factory" string="Ex-Factory Date" date="date_ex_factory"/>
                <group expand="0" string="Group By">
                    <filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_style" string="Style" context="{'group_by': 'style_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date_ex_factory:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_garment_order_pnl_pivot" model="ir.ui.view">
        <field name="name">garment.order.pnl.pivot</field>
        <field name="model">garment.order.pnl</field>
        <field name="arch" type="xml">
            <pivot string="Order P&amp;L" sample="1">
                <field name="buyer_id" type="row"/>
                <field name="date_ex_factory" interval="month" type="col"/>
                <field name="revenue" type="measure"/>
                <field name="actual_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_garment_order_pnl_graph" model="ir.ui.view">
        <field name="name">garment.order.pnl.graph</field>
        <field name="model">garment.order.pnl</field>
        <field name="arch" type="xml">
            <graph string="Order P&amp;L" type="bar" sample="1">
                <field name="buyer_id"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_garment_order_pnl" model="ir.actions.act_window">
        <field name="name">Order P&amp;L</field>
        <field name="res_model">garment.order.pnl</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_closed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No order P&amp;L yet</p>
            <p>Pick a production order: its invoiced revenue is set against the approved cost sheet and the
                actual material, wages, job work and other costs.</p>
        </field>
    </record>

    <record id="garment_order_view_form_pnl" model="ir.ui.view">
        <field name="name">garment.order.form.pnl</field>
        <field name="model">garment.order</field>
        <field name="inherit_id" ref="zyra_garment_merch.garment_order_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_pnl" type="object" class="oe_stat_button" icon="fa-line-chart"
                        string="P&amp;L" invisible="state in ('draft', 'cancel')"
                        groups="zyra_garment_base.group_garment_costing,zyra_garment_base.group_garment_factory_manager,zyra_garment_base.group_garment_admin"/>
            </div>
        </field>
    </record>

    <menuitem id="menu_garment_finance" name="Finance" parent="zyra_garment_base.menu_garment_root" sequence="95"
              groups="zyra_garment_base.group_garment_costing,zyra_garment_base.group_garment_factory_manager,zyra_garment_base.group_garment_admin,zyra_garment_base.group_garment_merchandiser"/>
    <menuitem id="menu_garment_order_pnl" name="Order P&amp;L" parent="menu_garment_finance" sequence="10"
              action="action_garment_order_pnl"/>
</odoo>
