<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_garment_jobwork_order" model="ir.sequence">
        <field name="name">Job Work Order</field>
        <field name="code">garment.jobwork.order</field>
        <field name="prefix">JW/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="stock_location_jobwork" model="stock.location">
        <field name="name">Job Work Vendors</field>
        <field name="location_id" ref="stock.stock_location_locations"/>
        <field name="usage">internal</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="product_jobwork_pieces" model="product.product">
        <field name="name">Garment Pieces (Job Work)</field>
        <field name="default_code">ZG-JW-PCS</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="product_jobwork_service" model="product.product">
        <field name="name">Job Work Charge</field>
        <field name="default_code">ZG-JW-SVC</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="purchase_method">purchase</field>
    </record>
</odoo>
