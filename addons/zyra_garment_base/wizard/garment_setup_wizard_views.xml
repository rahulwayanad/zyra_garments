<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screen 119: Factory Setup -->
    <record id="garment_setup_wizard_view_form" model="ir.ui.view">
        <field name="name">garment.setup.wizard.form</field>
        <field name="model">garment.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Factory Setup" class="o_zyra_setup">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="row">
                        <div class="col-lg-6">
                            <separator string="Business models you run"/>
                            <div class="o_zyra_check"><field name="model_fob" nolabel="1"/><label for="model_fob"/></div>
                            <div class="o_zyra_check"><field name="model_cmt" nolabel="1"/><label for="model_cmt"/></div>
                            <div class="o_zyra_check"><field name="model_own_brand" nolabel="1"/><label for="model_own_brand"/></div>
                            <div class="o_zyra_check"><field name="model_mtm" nolabel="1"/><label for="model_mtm"/></div>
                            <div class="o_zyra_check"><field name="model_decoration" nolabel="1"/><label for="model_decoration"/></div>
                        </div>
                        <div class="col-lg-6">
                            <separator string="Areas in the menu"/>
                            <div class="o_zyra_check"><field name="area_merch" nolabel="1"/><label for="area_merch"/></div>
                            <div class="o_zyra_check"><field name="area_materials" nolabel="1"/><label for="area_materials"/></div>
                            <div class="o_zyra_check"><field name="area_cutting" nolabel="1"/><label for="area_cutting"/></div>
                            <div class="o_zyra_check"><field name="area_sewing" nolabel="1"/><label for="area_sewing"/></div>
                            <div class="o_zyra_check"><field name="area_jobwork" nolabel="1"/><label for="area_jobwork"/></div>
                            <div class="o_zyra_check"><field name="area_quality" nolabel="1"/><label for="area_quality"/></div>
                            <div class="o_zyra_check"><field name="area_shipping" nolabel="1"/><label for="area_shipping"/></div>
                            <div class="o_zyra_check"><field name="area_wages" nolabel="1"/><label for="area_wages"/></div>
                            <div class="o_zyra_check"><field name="area_compliance" nolabel="1"/><label for="area_compliance"/></div>
                        </div>
                    </div>
                    <group>
                        <group string="Working time">
                            <field name="working_minutes_per_day"/>
                            <field name="target_efficiency"/>
                            <field name="week_start"/>
                        </group>
                        <group string="Roles">
                            <field name="role_line_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </group>
                        <group string="Costing and fabric figures">
                            <field name="minute_value"/>
                            <field name="margin_floor_pct"/>
                            <field name="fabric_accept_points"/>
                        </group>
                        <group string="Size ranges and libraries">
                            <field name="preset_s_xl"/>
                            <field name="preset_xs_xxl"/>
                            <field name="preset_kids_2_14"/>
                            <field name="load_pom_library"/>
                            <field name="load_defect_library"/>
                            <field name="pom_count" string="Points of measure loaded"/>
                            <field name="defect_count" string="Defects loaded"/>
                        </group>
                    </group>
                    <button name="action_save_setup" type="object" string="Save setup" class="btn-primary mt-3"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_setup_wizard" model="ir.actions.act_window">
        <field name="name">Factory Setup</field>
        <field name="res_model">garment.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
