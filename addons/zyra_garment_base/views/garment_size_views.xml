<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_size_range_view_list" model="ir.ui.view">
        <field name="name">garment.size.range.list</field>
        <field name="model">garment.size.range</field>
        <field name="arch" type="xml">
            <list string="Size Ranges">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="size_names"/>
                <field name="size_count" string="Sizes"/>
            </list>
        </field>
    </record>

    <record id="garment_size_range_view_form" model="ir.ui.view">
        <field name="name">garment.size.range.form</field>
        <field name="model">garment.size.range</field>
        <field name="arch" type="xml">
            <form string="Size Range">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. S-XL"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <separator string="Sizes in order"/>
                    <field name="size_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garment_size_range_view_search" model="ir.ui.view">
        <field name="name">garment.size.range.search</field>
        <field name="model">garment.size.range</field>
        <field name="arch" type="xml">
            <search string="Size Ranges">
                <field name="name"/>
                <field name="size_ids" string="Size"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_garment_size_range" model="ir.actions.act_window">
        <field name="name">Size Ranges</field>
        <field name="res_model">garment.size.range</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create size ranges from a preset in Factory Setup, or add your own.</p>
        </field>
    </record>
</odoo>
