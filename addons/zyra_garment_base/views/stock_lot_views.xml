<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fabric roll fields on the standard lot form -->
    <record id="stock_lot_view_form_garment" model="ir.ui.view">
        <field name="name">stock.lot.form.garment</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fabric Roll" name="garment_fabric_roll">
                    <group>
                        <group>
                            <field name="is_fabric_roll"/>
                            <field name="roll_status" invisible="not is_fabric_roll"/>
                            <field name="roll_hold_reason" invisible="not is_fabric_roll or roll_status not in ('hold', 'rejected')"/>
                            <field name="dye_lot" invisible="not is_fabric_roll"/>
                        </group>
                        <group invisible="not is_fabric_roll">
                            <field name="shade_group"/>
                            <field name="shrinkage_group"/>
                            <field name="width_cm"/>
                            <field name="gsm"/>
                            <field name="points_per_100sqyd"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Dedicated fabric roll form (materials may extend it for screen 42) -->
    <record id="stock_lot_view_form_garment_roll" model="ir.ui.view">
        <field name="name">stock.lot.form.garment.roll</field>
        <field name="model">stock.lot</field>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Fabric Roll">
                <header>
                    <button name="action_roll_approve" type="object" string="Approve" class="btn-primary"
                            invisible="roll_status not in ('received', 'hold')"/>
                    <button name="action_roll_hold" type="object" string="Hold"
                            invisible="roll_status not in ('received', 'approved')"/>
                    <button name="action_roll_reject" type="object" string="Reject"
                            invisible="roll_status == 'rejected'"/>
                    <button name="action_roll_reset" type="object" string="Reset to Received"
                            invisible="roll_status != 'rejected'"
                            groups="zyra_garment_base.group_garment_factory_manager"/>
                    <field name="roll_status" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="is_fabric_roll" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Fabric roll"/>
                        <h1><field name="name" placeholder="e.g. R00701"/></h1>
                    </div>
                    <group>
                        <group string="Fabric">
                            <field name="product_id" string="Fabric" context="{'default_is_storable': True, 'default_tracking': 'lot'}"/>
                            <field name="dye_lot"/>
                            <field name="ref" string="Supplier Lot"/>
                            <field name="product_qty" string="On Hand"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                        </group>
                        <group string="Quality">
                            <field name="points_per_100sqyd"/>
                            <field name="shade_group"/>
                            <field name="shrinkage_group"/>
                            <field name="roll_hold_reason" invisible="roll_status not in ('hold', 'rejected')"/>
                        </group>
                        <group string="Measures">
                            <field name="width_cm"/>
                            <field name="gsm"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="stock_lot_view_list_garment_roll" model="ir.ui.view">
        <field name="name">stock.lot.list.garment.roll</field>
        <field name="model">stock.lot</field>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Fabric Rolls">
                <field name="name" string="Roll"/>
                <field name="product_id" string="Fabric"/>
                <field name="dye_lot"/>
                <field name="shade_group"/>
                <field name="shrinkage_group"/>
                <field name="width_cm" optional="show"/>
                <field name="gsm" optional="show"/>
                <field name="points_per_100sqyd" optional="show"/>
                <field name="product_qty" string="On Hand"/>
                <field name="roll_status" widget="badge"
                       decoration-success="roll_status == 'approved'"
                       decoration-warning="roll_status == 'hold'"
                       decoration-danger="roll_status == 'rejected'"
                       decoration-info="roll_status == 'received'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="stock_lot_view_search_garment_roll" model="ir.ui.view">
        <field name="name">stock.lot.search.garment.roll</field>
        <field name="model">stock.lot</field>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Fabric Rolls">
                <field name="name" string="Roll"/>
                <field name="product_id" string="Fabric"/>
                <field name="dye_lot"/>
                <field name="shade_group"/>
                <filter string="Received" name="received" domain="[('roll_status', '=', 'received')]"/>
                <filter string="Approved" name="approved" domain="[('roll_status', '=', 'approved')]"/>
                <filter string="On Hold" name="hold" domain="[('roll_status', '=', 'hold')]"/>
                <filter string="Rejected" name="rejected" domain="[('roll_status', '=', 'rejected')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'roll_status'}"/>
                    <filter string="Fabric" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Shade Group" name="group_shade" context="{'group_by': 'shade_group'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_garment_fabric_roll" model="ir.actions.act_window">
        <field name="name">Fabric Rolls</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_fabric_roll', '=', True)]</field>
        <field name="context">{'default_is_fabric_roll': True}</field>
        <field name="search_view_id" ref="stock_lot_view_search_garment_roll"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('stock_lot_view_list_garment_roll')}),
            Command.create({'view_mode': 'form', 'view_id': ref('stock_lot_view_form_garment_roll')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Fabric rolls are lots of fabric products; they appear here when received.</p>
        </field>
    </record>
</odoo>
