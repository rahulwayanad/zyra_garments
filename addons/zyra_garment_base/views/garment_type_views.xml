<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_type_view_list" model="ir.ui.view">
        <field name="name">garment.type.list</field>
        <field name="model">garment.type</field>
        <field name="arch" type="xml">
            <list string="Garment Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="default_sam"/>
            </list>
        </field>
    </record>

    <record id="garment_type_view_form" model="ir.ui.view">
        <field name="name">garment.type.form</field>
        <field name="model">garment.type</field>
        <field name="arch" type="xml">
            <form string="Garment Types">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="default_sam"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garment_type_view_search" model="ir.ui.view">
        <field name="name">garment.type.search</field>
        <field name="model">garment.type</field>
        <field name="arch" type="xml">
            <search string="Garment Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_garment_type" model="ir.actions.act_window">
        <field name="name">Garment Types</field>
        <field name="res_model">garment.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a garment type with its typical SAM.</p>
        </field>
    </record>
</odoo>
