<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_colour_view_list" model="ir.ui.view">
        <field name="name">garment.colour.list</field>
        <field name="model">garment.colour</field>
        <field name="arch" type="xml">
            <list string="Colours">
                <field name="hex" widget="color"/>
                <field name="code"/>
                <field name="name"/>
                <field name="pantone"/>
            </list>
        </field>
    </record>

    <record id="garment_colour_view_form" model="ir.ui.view">
        <field name="name">garment.colour.form</field>
        <field name="model">garment.colour</field>
        <field name="arch" type="xml">
            <form string="Colours">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="pantone"/>
                        <field name="hex" widget="color"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garment_colour_view_search" model="ir.ui.view">
        <field name="name">garment.colour.search</field>
        <field name="model">garment.colour</field>
        <field name="arch" type="xml">
            <search string="Colours">
                <field name="name"/>
                <field name="code"/>
                <field name="pantone"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_garment_colour" model="ir.actions.act_window">
        <field name="name">Colours</field>
        <field name="res_model">garment.colour</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the colours your buyers order in.</p>
        </field>
    </record>
</odoo>
