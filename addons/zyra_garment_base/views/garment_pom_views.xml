<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_pom_view_list" model="ir.ui.view">
        <field name="name">garment.pom.list</field>
        <field name="model">garment.pom</field>
        <field name="arch" type="xml">
            <list string="Points of Measure">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="garment_category"/>
                <field name="default_tolerance"/>
                <field name="how_to_measure" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="garment_pom_view_form" model="ir.ui.view">
        <field name="name">garment.pom.form</field>
        <field name="model">garment.pom</field>
        <field name="arch" type="xml">
            <form string="Points of Measure">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="garment_category"/>
                        <field name="default_tolerance"/>
                        <field name="how_to_measure"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garment_pom_view_search" model="ir.ui.view">
        <field name="name">garment.pom.search</field>
        <field name="model">garment.pom</field>
        <field name="arch" type="xml">
            <search string="Points of Measure">
                <field name="code"/>
                <field name="name"/>
                <filter string="Tops" name="tops" domain="[('garment_category', 'in', ('top', 'both'))]"/>
                <filter string="Bottoms" name="bottoms" domain="[('garment_category', 'in', ('bottom', 'both'))]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_garment_pom" model="ir.actions.act_window">
        <field name="name">Points of Measure</field>
        <field name="res_model">garment.pom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Load the shipped library from Factory Setup, or add your own points of measure.</p>
        </field>
    </record>
</odoo>
