<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_garment" model="ir.ui.view">
        <field name="name">res.partner.form.garment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Garment" name="garment">
                    <group>
                        <group string="Buyer">
                            <field name="is_garment_buyer"/>
                            <field name="buyer_code" invisible="not is_garment_buyer"/>
                        </group>
                        <group string="Vendor">
                            <field name="is_jobwork_vendor"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search_garment" model="ir.ui.view">
        <field name="name">res.partner.search.garment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter string="Garment Buyers" name="garment_buyers" domain="[('is_garment_buyer', '=', True)]"/>
                <filter string="Job-work Vendors" name="jobwork_vendors" domain="[('is_jobwork_vendor', '=', True)]"/>
            </xpath>
            <field name="name" position="after">
                <field name="buyer_code"/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_list_garment_buyer" model="ir.ui.view">
        <field name="name">res.partner.list.garment.buyer</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Buyers">
                <field name="buyer_code"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="action_garment_buyer" model="ir.actions.act_window">
        <field name="name">Buyers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_garment_buyer', '=', True)]</field>
        <field name="context">{'default_is_garment_buyer': True, 'default_is_company': True}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('res_partner_view_list_garment_buyer')}),
            Command.create({'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the buyers who place garment orders with you.</p>
        </field>
    </record>

    <record id="action_garment_jobwork_vendor" model="ir.actions.act_window">
        <field name="name">Job-work Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_jobwork_vendor', '=', True)]</field>
        <field name="context">{'default_is_jobwork_vendor': True, 'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the vendors who print, embroider, wash or sew for you.</p>
        </field>
    </record>
</odoo>
