<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_season_view_list" model="ir.ui.view">
        <field name="name">garment.season.list</field>
        <field name="model">garment.season</field>
        <field name="arch" type="xml">
            <list string="Seasons">
                <field name="code"/>
                <field name="name"/>
                <field name="year"/>
            </list>
        </field>
    </record>

    <record id="garment_season_view_form" model="ir.ui.view">
        <field name="name">garment.season.form</field>
        <field name="model">garment.season</field>
        <field name="arch" type="xml">
            <form string="Seasons">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="year"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garment_season_view_search" model="ir.ui.view">
        <field name="name">garment.season.search</field>
        <field name="model">garment.season</field>
        <field name="arch" type="xml">
            <search string="Seasons">
                <field name="name"/>
                <field name="code"/>
                <field name="year"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_garment_season" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">garment.season</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a season, e.g. SS27 Spring Summer 2027.</p>
        </field>
    </record>
</odoo>
