<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Libraries and size presets, as the Factory Setup would load them -->
    <function model="garment.library" name="_load_demo_libraries"/>

    <record id="partner_buyer_northwind" model="res.partner">
        <field name="name">Northwind Apparel Ltd</field>
        <field name="is_company" eval="True"/>
        <field name="is_garment_buyer" eval="True"/>
        <field name="buyer_code">NWA</field>
        <field name="country_id" ref="base.uk"/>
        <field name="city">London</field>
        <field name="email">orders@northwind.example.com</field>
    </record>
    <record id="partner_buyer_bluefin" model="res.partner">
