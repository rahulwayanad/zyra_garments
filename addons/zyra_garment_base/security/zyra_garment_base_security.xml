<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_garment" model="ir.module.category">
        <field name="name">Garment</field>
        <field name="description">Roles of the Zyra garment factory modules.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_garment_merchandiser" model="res.groups">
        <field name="name">Merchandiser</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_techpack_designer" model="res.groups">
        <field name="name">Tech Pack Designer</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_costing" model="res.groups">
        <field name="name">Costing</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_fabric_store" model="res.groups">
        <field name="name">Fabric Store</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_garment_cutting" model="res.groups">
        <field name="name">Cutting</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_line_supervisor" model="res.groups">
        <field name="name">Line Supervisor</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_quality" model="res.groups">
        <field name="name">Quality</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_packing_shipping" model="res.groups">
        <field name="name">Packing &amp; Shipping</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_wages" model="res.groups">
        <field name="name">Wages</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_garment_factory_manager" model="res.groups">
        <field name="name">Factory Manager</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="comment">Sees and approves everything on the floor: implies every operational garment role.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_garment_merchandiser')), Command.link(ref('group_garment_techpack_designer')), Command.link(ref('group_garment_costing')), Command.link(ref('group_garment_fabric_store')), Command.link(ref('group_garment_cutting')), Command.link(ref('group_garment_line_supervisor')), Command.link(ref('group_garment_quality')), Command.link(ref('group_garment_packing_shipping')), Command.link(ref('group_garment_wages'))]"/>
    </record>

    <record id="group_garment_admin" model="res.groups">
        <field name="name">Garment Admin</field>
        <field name="category_id" ref="module_category_garment"/>
        <field name="comment">Runs the factory setup and keeps the libraries; implies Factory Manager.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_garment_factory_manager'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
