<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_scan_view_list" model="ir.ui.view">
        <field name="name">garment.scan.list</field>
        <field name="model">garment.scan</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="scanned_at" string="Scanned At"/>
                <field name="coupon_id" string="Coupon"/>
                <field name="employee_id"/>
                <field name="line_id"/>
                <field name="order_id"/>
                <field name="bundle_id"/>
                <field name="operation_line_id"/>
                <field name="pieces" sum="Total"/>
                <field name="minutes_earned" string="Minutes" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="earnings" string="Earned" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="garment_scan_view_form" model="ir.ui.view">
        <field name="name">garment.scan.form</field>
        <field name="model">garment.scan</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="coupon_id"/>
                            <field name="employee_id"/>
                            <field name="line_id"/>
                            <field name="order_id"/>
                            <field name="bundle_id"/>
                            <field name="operation_line_id"/>
                            <field name="scanned_at"/>
                        </group>
                        <group>
                            <field name="pieces"/>
                            <field name="rejected_qty"/>
                            <field name="sam"/>
                            <field name="minutes_earned"/>
                            <field name="minute_rate"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="earnings"/>
                            <field name="is_last_operation"/>
                            <field name="client_uuid"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="garment_scan_view_search" model="ir.ui.view">
        <field name="name">garment.scan.search</field>
        <field name="model">garment.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="bundle_id"/>
                <field name="order_id"/>
                <field name="line_id"/>
                <filter name="today" string="Today"
                        domain="[('scanned_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_line" string="Line" context="{'group_by': 'line_id'}"/>
                    <filter name="group_operator" string="Operator" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_garment_scan" model="ir.actions.act_window">
        <field name="name">Coupon Scans</field>
        <field name="res_model">garment.scan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_today": 1}</field>
    </record>
</odoo>
